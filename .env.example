# =========================================================================
# MEDISENSE AI - ENVIRONMENT CONFIGURATION
# =========================================================================

# Server Ports
PORT=4000
FRONTEND_PORT=3000
NODE_ENV=development

# Database Configuration
# Leave DATABASE_URL empty to use zero-config embedded PGlite, or point to standard PostgreSQL:
# DATABASE_URL=
PGLITE_DIR=.data/medisense_db

# Security & JWT Token Secrets
JWT_SECRET=replace_with_a_long_random_secret

# AI Integrations (OpenRouter Free Models: Meta Llama 3.3 70B Instruct)
# If omitted or offline, Medisense automatically uses its built-in clinical inference engine!
OPENROUTER_API_KEY=replace_with_your_private_openrouter_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
APP_URL=http://localhost:3000

# Telephony & Messaging Simulation
VITE_API_BASE_URL=
TWILIO_ACCOUNT_SID=optional_twilio_sid
TWILIO_AUTH_TOKEN=optional_twilio_token
SENDGRID_API_KEY=optional_sendgrid_key

# WebRTC & Google Maps API
GOOGLE_MAPS_API_KEY=optional_google_maps_key
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
